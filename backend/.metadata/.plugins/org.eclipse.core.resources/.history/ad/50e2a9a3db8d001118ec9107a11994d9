package com.factoryflow.auth.InterfaceService;

public interface IOTPService {

    String sendOTP(String phone);

    /**
     * Validates the code for the given email. Throws if it's missing,
     * expired, or wrong. Does not look up the user or issue a token -
     * that's the facade's job (it already has the User from the
     * credential-check step and calls JwtUtil itself).
     */
    void verifyOTP(String email, String otp);
}
