package com.factoryflow.auth.facade;

import com.factoryflow.auth.dto.AuthRequest;
import com.factoryflow.auth.dto.LoginResponse;

public interface IAuthFacade {

	/**
	 * Handles the whole login flow behind one call:
	 *   - request.otp blank  -> validate email/password, send OTP, return status=OTP_SENT
	 *   - request.otp filled -> validate email/password again, verify the OTP,
	 *                           issue a JWT, return status=LOGIN_SUCCESS with the token
	 */
	LoginResponse login(AuthRequest request);

}
