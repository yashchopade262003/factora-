package com.factoryflow.auth.dto;
import lombok.AllArgsConstructor;
import lombok.Data;
import lombok.NoArgsConstructor;

@Data
@NoArgsConstructor
@AllArgsConstructor
public class LoginResponse {

    // "OTP_SENT" for the first call (credentials verified, otp emailed,
    // token/user fields are all null) or "LOGIN_SUCCESS" for the second
    // call (otp verified, token issued).
    private String status;

    private String token;

    private Long userId;

    private String username;

    private String email;

    private String role;

    private Long vendorId;

}